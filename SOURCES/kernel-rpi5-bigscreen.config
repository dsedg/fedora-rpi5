# Slimline settings for the Plasma Bigscreen Raspberry Pi 5 image.
# Keep Pi HDMI/V3D, audio, Wi-Fi/Bluetooth, USB, TV/radio capture, and add-ons.

# Non-Pi discrete/virtual display adapters.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_AST is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_MGAG200 is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_QXL is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_VMWGFX is not set

# Keep the Pi 5 Broadcom SDIO Wi-Fi; drop unrelated Wi-Fi card vendors.
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_BRCMFMAC_PCIE is not set
# CONFIG_BRCMFMAC_USB is not set
# CONFIG_WLAN_VENDOR_ATH is not set
